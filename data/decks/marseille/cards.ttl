    tarot:visualDescription "The Empress enthroned."@en .

mar:LEmpereur a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "L'Empereur"@fr, "The Emperor"@en ;
    tarot:cardNumber 4 ;
