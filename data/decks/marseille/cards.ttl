    skos:prefLabel "Le Chariot"@fr, "The Chariot"@en ;
    tarot:cardNumber 7 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M07.jpg> ;
