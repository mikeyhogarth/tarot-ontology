    tarot:visualDescription "A horned devil above two small chained figures."@en .

mar:LaMaisonDieu a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "La Maison Dieu"@fr, "The House of God"@en ;
    tarot:cardNumber 16 ;
