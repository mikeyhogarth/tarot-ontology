    tarot:visualDescription "A tower struck from above, with figures falling."@en .

mar:LEtoile a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "L'Étoile"@fr, "The Star"@en ;
    tarot:cardNumber 17 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M17.jpg> ;
    tarot:visualDescription "A nude woman pouring water beneath a large star."@en .

mar:LaLune a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "La Lune"@fr, "The Moon"@en ;
    tarot:cardNumber 18 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M18.jpg> ;
    tarot:visualDescription "The Moon above two dogs and a crayfish."@en .

mar:LeSoleil a tarot:MajorArcanaCard ;
