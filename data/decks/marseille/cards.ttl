    tarot:cardNumber 20 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M20.jpg> ;
    tarot:visualDescription "An angel sounding a trumpet over figures rising from their graves."@en .

mar:LeMonde a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "Le Monde"@fr, "The World"@en ;
    tarot:cardNumber 21 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M21.jpg> ;
    tarot:visualDescription "A figure within a wreath, with four creatures at the corners."@en .

