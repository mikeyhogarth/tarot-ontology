@prefix tarot: <https://w3id.org/tarot/ontology#> .
@prefix mar:   <https://w3id.org/tarot/deck/marseille#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix void:    <http://rdfs.org/ns/void#> .

# The Tarot of Marseilles. Names follow the Marseilles tradition, and images are the Jean Dodal deck
# (Lyon, c. 1701-1715; public domain).

<https://w3id.org/tarot/deck/marseille> a void:Dataset ;
    dcterms:title "Tarot de Marseille deck data"@en ;
    dcterms:description "The cards of the Tarot de Marseille deck."@en ;
    dcterms:creator <https://github.com/mikeyhogarth> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-30"^^xsd:date .

#################################################################
# DECK
#################################################################

mar:Deck a tarot:Deck ;
    skos:prefLabel "Tarot of Marseilles"@en, "Tarot de Marseille"@fr ;
    rdfs:comment "A Tarot de Marseille deck, following the Marseilles tradition. Dated to the Jean Dodal edition (Lyon, c. 1701-1715)."@en ;
    dcterms:creator "Jean Dodal" ;
    dcterms:created "1701"^^xsd:gYear ;
    dcterms:language "fr" .

#################################################################
# MAJOR ARCANA
#################################################################

mar:LeMat a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "Le Mat"@fr, "The Fool"@en ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M00.jpg> .

mar:LeBateleur a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "Le Bateleur"@fr, "The Juggler"@en ;
    tarot:cardNumber 1 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M01.jpg> ;
    tarot:visualDescription "The Juggler or mountebank at his table."@en .

mar:LaPapesse a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "La Papesse"@fr, "The Popess"@en ;
    tarot:cardNumber 2 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M02.jpg> ;
    tarot:visualDescription "The female pope."@en .

mar:LImperatrice a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "L'Impératrice"@fr, "The Empress"@en ;
    tarot:cardNumber 3 ;
