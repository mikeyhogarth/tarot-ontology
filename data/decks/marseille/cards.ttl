    tarot:visualDescription "The Emperor enthroned."@en .

mar:LePape a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "Le Pape"@fr, "The Pope"@en ;
    tarot:cardNumber 5 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M05.jpg> ;
    tarot:visualDescription "The pope, with two acolytes."@en .

mar:LAmoureux a tarot:MajorArcanaCard ;
    tarot:inDeck mar:Deck ;
    skos:prefLabel "L'Amoureux"@fr, "The Lovers"@en ;
    tarot:cardNumber 6 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/Jean_Dodal_M06.jpg> ;
