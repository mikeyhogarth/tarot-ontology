#################################################################

rws:AceOfCups a tarot:PipCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "Ace of Cups"@en ;
    tarot:hasCardNumber 1 ;
    tarot:hasRank tarot:Ace ;
    tarot:hasSuit tarot:Cups ;
