    tarot:hasVisualDescription "Water pours into a pool from a golden chalice held by a hand emerging from a cloud."@en ;
    corr:correspondsToElement corr:Water .

rws:TwoOfCups a tarot:PipCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "Two of Cups"@en ;
    tarot:hasCardNumber 2 ;
    tarot:hasRank tarot:Two ;
    tarot:hasSuit tarot:Cups ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_Cups_02.jpeg> ;
    tarot:hasVisualDescription "Two figures facing each other, each holding a goblet. Above them is a lion's head atop a caduceus."@en ;
    corr:correspondsToElement corr:Water .

rws:ThreeOfCups a tarot:PipCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "Three of Cups"@en ;
    tarot:hasCardNumber 3 ;
    tarot:hasRank tarot:Three ;
