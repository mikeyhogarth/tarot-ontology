    tarot:hasVisualDescription "Two naked figures, one male, one female, stand facing each other with an angelic figure looking down on them."@en ;
    corr:correspondsToHebrewLetter corr:HebrewZayin ;
    corr:correspondsToElement corr:Air ;
    corr:correspondsToZodiacSign corr:Gemini ;
    corr:correspondsToCelestialBody corr:Mercury .

rws:TheChariot a tarot:MajorArcanaCard ;
