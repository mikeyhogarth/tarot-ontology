#################################################################    
# MINOR ARCANA — WANDS
#################################################################

rws:AceOfWands a tarot:PipCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "Ace of Wands"@en ;
    tarot:hasCardNumber 1 ;
    tarot:hasRank tarot:Ace ;
    tarot:hasSuit tarot:Wands ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_Wands_01.jpeg> ;
    tarot:hasVisualDescription "A hand holding a wand emerges from a cloud above hills and a river. Leaves sprout from the wand."@en ;
    corr:correspondsToElement corr:Fire .

