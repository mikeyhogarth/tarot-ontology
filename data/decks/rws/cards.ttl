@prefix tarot: <https://w3id.org/tarot/ontology#> .
@prefix rws:   <https://w3id.org/tarot/deck/rws#> .
@prefix corr:  <https://w3id.org/tarot/correspondence#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix void:    <http://rdfs.org/ns/void#> .

# The Rider-Waite-Smith tarot. Names follow the 1909 edition (William Rider & Son, London), illustrated by
# Pamela Colman Smith under the direction of Arthur Edward Waite; images are that edition (public domain,
# from Wikimedia Commons). Correspondences follow the Golden Dawn tradition.

<https://w3id.org/tarot/deck/rws> a void:Dataset ;
    dcterms:title "Rider-Waite-Smith deck data"@en ;
    dcterms:description "The cards of the Rider-Waite-Smith tarot deck."@en ;
    dcterms:creator <https://github.com/mikeyhogarth> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-30"^^xsd:date .

#################################################################
# DECK
#################################################################

rws:Deck a tarot:Deck ;
    skos:prefLabel "Rider-Waite-Smith"@en ;
    rdfs:comment "The Rider-Waite-Smith tarot deck, published in 1909 by William Rider & Son and illustrated by Pamela Colman Smith."@en ;
    dcterms:creator "Pamela Colman Smith", "Arthur Edward Waite" ;
    dcterms:publisher "William Rider & Son" ;
    dcterms:created "1909"^^xsd:gYear ;
    dcterms:language "en" .

#################################################################
# MAJOR ARCANA
#################################################################

rws:TheFool a tarot:MajorArcanaCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "The Fool"@en ;
    tarot:hasCardNumber 0 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_00_Fool.jpeg> ;
    tarot:hasVisualDescription "A young man walks towards a cliff edge, either oblivious or carefree. He is holding a flower and a knapsack and is accompanied by a dog."@en ;
    corr:correspondsToHebrewLetter corr:HebrewAleph ;
    corr:correspondsToElement corr:Air ;
    corr:correspondsToCelestialBody corr:Uranus .

rws:TheMagician a tarot:MajorArcanaCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "The Magician"@en ;
    tarot:hasCardNumber 1 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_01_Magician.jpeg> ;
    tarot:hasVisualDescription "A robed man stands, one hand holding a wand aloft and the other pointing towards the ground. On the table in front of him lie four objects representing the suits of the minor arcana."@en ;
    corr:correspondsToHebrewLetter corr:HebrewBeth ;
    corr:correspondsToElement corr:Air ;
    corr:correspondsToZodiacSign corr:Virgo ;
    corr:correspondsToCelestialBody corr:Mercury .

rws:TheHighPriestess a tarot:MajorArcanaCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "The High Priestess"@en ;
    tarot:hasCardNumber 2 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_02_High_Priestess.jpeg> ;
    tarot:hasVisualDescription "A woman robed in pale blue and wearing a moon headdress sits between two pillars (one dark, one light) holding a scroll."@en ;
    corr:correspondsToHebrewLetter corr:HebrewGimel ;
    corr:correspondsToElement corr:Water ;
    corr:correspondsToZodiacSign corr:Pisces ;
    corr:correspondsToCelestialBody corr:Moon .

rws:TheEmpress a tarot:MajorArcanaCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "The Empress"@en ;
    tarot:hasCardNumber 3 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_03_Empress.jpeg> ;
    tarot:hasVisualDescription "A woman wearing a crown of stars sits on a cushioned throne surrounded by trees and fields. A river flows in the background."@en ;
    corr:correspondsToHebrewLetter corr:HebrewDalet ;
    corr:correspondsToElement corr:Earth ;
    corr:correspondsToZodiacSign corr:Taurus, corr:Libra ;
    corr:correspondsToCelestialBody corr:Venus .

rws:TheEmperor a tarot:MajorArcanaCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "The Emperor"@en ;
    tarot:hasCardNumber 4 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_04_Emperor.jpeg> ;
    tarot:hasVisualDescription "A stern-looking man in red robes holds an orb and sceptre and sits upon a stone throne."@en ;
    corr:correspondsToHebrewLetter corr:HebrewHeh ;
    corr:correspondsToElement corr:Fire ;
    corr:correspondsToZodiacSign corr:Aries ;
    corr:correspondsToCelestialBody corr:Mars .

rws:TheHierophant a tarot:MajorArcanaCard ;
    tarot:inDeck rws:Deck ;
    skos:prefLabel "The Hierophant"@en ;
    tarot:hasCardNumber 5 ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:FilePath/RWS1909_-_05_Hierophant.jpeg> ;
    tarot:hasVisualDescription "A man in religious garb sits between two pillars in front of two other figures looking up at him."@en ;
    corr:correspondsToHebrewLetter corr:HebrewVav ;
    corr:correspondsToElement corr:Earth ;
    corr:correspondsToZodiacSign corr:Taurus ;
    corr:correspondsToCelestialBody corr:Venus .

rws:TheLovers a tarot:MajorArcanaCard ;
