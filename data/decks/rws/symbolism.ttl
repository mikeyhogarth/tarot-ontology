@prefix tarot: <https://w3id.org/tarot/ontology#> .
@prefix rws:   <https://w3id.org/tarot/deck/rws#> .
@prefix symbol: <https://w3id.org/tarot/symbol#> .

# 
# What the picture on each Rider-Waite-Smith card depicts. For this dataset, the most 
# specific concepts in the symbols vocabulary are the only ones that should be stated 
# for each card - the rest can be inferred through through the SKOS hierarchy.
#
rws:TheFool tarot:depictsSymbol
    symbol:Cliff, symbol:Dog, symbol:Feather, symbol:Knapsack, symbol:LeftProfile,
    symbol:Mountain, symbol:Rose, symbol:Staff, symbol:Sun, symbol:UpwardGaze, symbol:Wreath .

rws:TheMagician tarot:depictsSymbol
    symbol:Cup, symbol:FrontalPose, symbol:Infinity, symbol:Lily, symbol:Pentacle, symbol:Rose,
    symbol:Snake, symbol:Sword, symbol:Table, symbol:Wand .

