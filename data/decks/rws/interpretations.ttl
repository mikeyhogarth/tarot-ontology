@prefix tarot: <https://w3id.org/tarot/ontology#> .
@prefix rws:   <https://w3id.org/tarot/deck/rws#> .

# 
# Popular interpretations of the Rider-Waite-Smith cards: one common reading of each card. 
# These are presented in good faith as "popular interpretations" and do not seek to define 
# the one true interpretation of each card (humans are meant to do that part themselves).
#
rws:TheFool tarot:hasPopularInterpretation "The beginning of the journey: innocence, spontaneity and a leap of faith."@en .

rws:TheMagician tarot:hasPopularInterpretation "Willpower and skill: turning intention into action."@en .

rws:TheHighPriestess tarot:hasPopularInterpretation "Intuition and hidden knowledge."@en .

rws:TheEmpress tarot:hasPopularInterpretation "Nurture, creativity, fertility and abundance."@en .

rws:TheEmperor tarot:hasPopularInterpretation "Authority, structure and stable leadership."@en .

rws:TheHierophant tarot:hasPopularInterpretation "Tradition, convention and spiritual guidance."@en .

rws:TheLovers tarot:hasPopularInterpretation "Love, harmony and the weight of a meaningful choice."@en .

rws:TheChariot tarot:hasPopularInterpretation "Determination and control: victory through willpower."@en .

rws:Strength tarot:hasPopularInterpretation "Courage, patience and gentle inner strength."@en .

rws:TheHermit tarot:hasPopularInterpretation "Solitude, introspection and searching for inner wisdom."@en .

rws:WheelOfFortune tarot:hasPopularInterpretation "Cycles, fate and turning points."@en .

rws:Justice tarot:hasPopularInterpretation "Fairness, truth and cause and effect."@en .

rws:TheHangedMan tarot:hasPopularInterpretation "Surrender, pause and seeing things from a new angle."@en .

rws:Death tarot:hasPopularInterpretation "Endings and transformation: one chapter closes so another can begin."@en .

rws:Temperance tarot:hasPopularInterpretation "Balance, moderation and patient blending."@en .

rws:TheDevil tarot:hasPopularInterpretation "Bondage, temptation and attachment to the material."@en .

rws:TheTower tarot:hasPopularInterpretation "Sudden upheaval and revelation: false structures collapse."@en .

rws:TheStar tarot:hasPopularInterpretation "Hope, renewal and quiet inspiration."@en .

rws:TheMoon tarot:hasPopularInterpretation "Illusion, fear and the uncertain path of the unconscious."@en .

rws:TheSun tarot:hasPopularInterpretation "Joy, success and vitality."@en .

rws:Judgement tarot:hasPopularInterpretation "Reckoning, awakening and answering a higher calling."@en .

rws:TheWorld tarot:hasPopularInterpretation "Completion, wholeness and fulfilment."@en .

rws:AceOfWands tarot:hasPopularInterpretation "Inspiration, new ventures and creative spark."@en .

rws:TwoOfWands tarot:hasPopularInterpretation "Planning, vision and looking beyond the horizon."@en .

rws:ThreeOfWands tarot:hasPopularInterpretation "Expansion, foresight and progress under way."@en .

rws:FourOfWands tarot:hasPopularInterpretation "Celebration, homecoming and stability."@en .

rws:FiveOfWands tarot:hasPopularInterpretation "Competition, conflict and clashing ambitions."@en .

rws:SixOfWands tarot:hasPopularInterpretation "Victory, recognition and public acclaim."@en .

rws:SevenOfWands tarot:hasPopularInterpretation "Defending your position against challenge."@en .

rws:EightOfWands tarot:hasPopularInterpretation "Swift movement, momentum and news on the way."@en .

rws:NineOfWands tarot:hasPopularInterpretation "Resilience and persistence: holding the line."@en .

rws:TenOfWands tarot:hasPopularInterpretation "Burden and over-commitment: carrying too much."@en .

rws:PageOfWands tarot:hasPopularInterpretation "Enthusiasm, exploration and a message of new possibilities."@en .

rws:KnightOfWands tarot:hasPopularInterpretation "Energy, passion and impulsive adventure."@en .

rws:QueenOfWands tarot:hasPopularInterpretation "Confidence, warmth and determination."@en .

rws:KingOfWands tarot:hasPopularInterpretation "Visionary leadership and bold entrepreneurship."@en .

rws:AceOfCups tarot:hasPopularInterpretation "New love, emotional overflow and compassion."@en .

rws:TwoOfCups tarot:hasPopularInterpretation "Partnership, mutual attraction and union."@en .

rws:ThreeOfCups tarot:hasPopularInterpretation "Friendship, celebration and community."@en .

rws:FourOfCups tarot:hasPopularInterpretation "Apathy, contemplation and missed offers."@en .

rws:FiveOfCups tarot:hasPopularInterpretation "Loss and regret: dwelling on what has been spilled."@en .

rws:SixOfCups tarot:hasPopularInterpretation "Nostalgia, childhood memories and innocence."@en .

rws:SevenOfCups tarot:hasPopularInterpretation "Choices, fantasy and wishful thinking."@en .

rws:EightOfCups tarot:hasPopularInterpretation "Walking away from what no longer fulfils."@en .

rws:NineOfCups tarot:hasPopularInterpretation "Contentment and wishes fulfilled."@en .

rws:TenOfCups tarot:hasPopularInterpretation "Domestic harmony and lasting happiness."@en .

rws:PageOfCups tarot:hasPopularInterpretation "Creative beginnings, intuition and tender feelings."@en .

rws:KnightOfCups tarot:hasPopularInterpretation "Romance, charm and following the heart."@en .

rws:QueenOfCups tarot:hasPopularInterpretation "Compassion, calm and emotional insight."@en .

rws:KingOfCups tarot:hasPopularInterpretation "Emotional balance, diplomacy and generosity."@en .

rws:AceOfSwords tarot:hasPopularInterpretation "Clarity, breakthrough and the power of truth."@en .

rws:TwoOfSwords tarot:hasPopularInterpretation "Stalemate and difficult decisions avoided."@en .

rws:ThreeOfSwords tarot:hasPopularInterpretation "Heartbreak, grief and painful truth."@en .

rws:FourOfSwords tarot:hasPopularInterpretation "Rest, recovery and contemplation."@en .

rws:FiveOfSwords tarot:hasPopularInterpretation "Conflict, hollow victory and winning at a cost."@en .

rws:SixOfSwords tarot:hasPopularInterpretation "Transition and moving towards calmer waters."@en .

rws:SevenOfSwords tarot:hasPopularInterpretation "Deception, strategy and getting away with something."@en .

rws:EightOfSwords tarot:hasPopularInterpretation "Restriction and feeling trapped by one's own thoughts."@en .

rws:NineOfSwords tarot:hasPopularInterpretation "Anxiety, worry and sleepless nights."@en .

rws:TenOfSwords tarot:hasPopularInterpretation "Painful endings and hitting rock bottom."@en .

rws:PageOfSwords tarot:hasPopularInterpretation "Curiosity, vigilance and a hunger for ideas."@en .

rws:KnightOfSwords tarot:hasPopularInterpretation "Ambition, haste and charging ahead."@en .

rws:QueenOfSwords tarot:hasPopularInterpretation "Clear judgement, independence and honest perception."@en .

rws:KingOfSwords tarot:hasPopularInterpretation "Intellectual authority, truth and ethics."@en .

rws:AceOfPentacles tarot:hasPopularInterpretation "A new material opportunity and prosperity."@en .

rws:TwoOfPentacles tarot:hasPopularInterpretation "Balancing priorities and adapting to change."@en .

rws:ThreeOfPentacles tarot:hasPopularInterpretation "Teamwork, craftsmanship and collaboration."@en .

rws:FourOfPentacles tarot:hasPopularInterpretation "Security, control and holding on too tightly."@en .

rws:FiveOfPentacles tarot:hasPopularInterpretation "Hardship, poverty and feeling left out in the cold."@en .

rws:SixOfPentacles tarot:hasPopularInterpretation "Generosity, charity and sharing wealth."@en .

rws:SevenOfPentacles tarot:hasPopularInterpretation "Patience, investment and long-term view."@en .

rws:EightOfPentacles tarot:hasPopularInterpretation "Diligence, skill and dedicated apprenticeship."@en .

rws:NineOfPentacles tarot:hasPopularInterpretation "Abundance, self-sufficiency and refinement."@en .

rws:TenOfPentacles tarot:hasPopularInterpretation "Wealth, legacy and family security."@en .

rws:PageOfPentacles tarot:hasPopularInterpretation "Ambition, study and a desire to learn."@en .

rws:KnightOfPentacles tarot:hasPopularInterpretation "Hard work, routine and steady progress."@en .

rws:QueenOfPentacles tarot:hasPopularInterpretation "Nurturing, practicality and providing for others."@en .

rws:KingOfPentacles tarot:hasPopularInterpretation "Abundance, security and disciplined success."@en .
