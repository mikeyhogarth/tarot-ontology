@prefix tarot:   <https://w3id.org/tarot/ontology#> .
@prefix corr:    <https://w3id.org/tarot/correspondence#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# An optional vocabulary of esoteric correspondences: the classes (elements, zodiac signs,
# celestial bodies, Hebrew letters) and properties that extend tarot:Correspondence and
# tarot:hasCorrespondence in the ontology, plus their individuals. It is published separately
# because only some traditions use them (notably the Golden Dawn); the ontology keeps the extension
# points, and the suits and ranks that nearly every system has.
#
# It makes no claims about any deck. Which card corresponds to which of these is stated by each
# deck (e.g. the Rider-Waite-Smith deck follows the Golden Dawn); other decks need not use them.

<https://w3id.org/tarot/correspondence> a owl:Ontology ;
    rdfs:label "Tarot Correspondences"@en ;
    dcterms:title "Tarot Correspondences"@en ;
    dcterms:description "A shared, optional vocabulary of esoteric correspondences used by some tarot traditions: elements, zodiac signs, celestial bodies and Hebrew letters. Which card corresponds to which is stated by each deck."@en ;
    dcterms:creator <https://github.com/mikeyhogarth> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-11-01"^^xsd:date ;
    dcterms:requires <https://w3id.org/tarot/ontology> ;
    vann:preferredNamespacePrefix "corr" ;
    vann:preferredNamespaceUri "https://w3id.org/tarot/correspondence#" .


#################################################################
# Classes
#################################################################

corr:Element a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subClassOf tarot:Correspondence ;
    rdfs:label "Element"@en ;
    rdfs:comment "One of the four classical elements: Fire, Water, Air or Earth."@en .

corr:ZodiacSign a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subClassOf tarot:Correspondence ;
    rdfs:label "Zodiac Sign"@en ;
    rdfs:comment "One of the twelve signs of the zodiac."@en .

corr:CelestialBody a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subClassOf tarot:Correspondence ;
    rdfs:label "Celestial Body"@en ;
    rdfs:comment "A planet or luminary, such as the Sun, the Moon or Venus."@en .

corr:HebrewLetter a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subClassOf tarot:Correspondence ;
    rdfs:label "Hebrew Letter"@en ;
    rdfs:comment "One of the twenty-two letters of the Hebrew alphabet."@en .

#################################################################
# Properties
#################################################################

corr:hasElement a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subPropertyOf tarot:hasCorrespondence ;
    rdfs:domain tarot:TarotCard ;
    rdfs:range corr:Element ;
    rdfs:label "corresponds to element"@en ;
    rdfs:comment "Relates a card to the element it corresponds to."@en .

corr:hasZodiacSign a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subPropertyOf tarot:hasCorrespondence ;
    rdfs:domain tarot:TarotCard ;
    rdfs:range corr:ZodiacSign ;
    rdfs:label "corresponds to zodiac sign"@en ;
    rdfs:comment "Relates a card to a zodiac sign it corresponds to."@en .

corr:hasCelestialBody a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subPropertyOf tarot:hasCorrespondence ;
    rdfs:domain tarot:TarotCard ;
    rdfs:range corr:CelestialBody ;
    rdfs:label "corresponds to celestial body"@en ;
    rdfs:comment "Relates a card to a planet or luminary it corresponds to."@en .

corr:hasHebrewLetter a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/tarot/correspondence> ;
    rdfs:subPropertyOf tarot:hasCorrespondence ;
    rdfs:domain tarot:TarotCard ;
    rdfs:range corr:HebrewLetter ;
    rdfs:label "corresponds to Hebrew letter"@en ;
    rdfs:comment "Relates a card to the Hebrew letter it corresponds to."@en .

#################################################################
# Individuals
#################################################################

# Elements

corr:Fire a corr:Element ;
    skos:prefLabel "Fire"@en ;
    rdfs:comment "The element of Fire."@en .

corr:Water a corr:Element ;
    skos:prefLabel "Water"@en ;
    rdfs:comment "The element of Water."@en .

