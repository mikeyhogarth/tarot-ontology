@prefix tarot: <https://w3id.org/tarot/ontology#> .
@prefix symbol: <https://w3id.org/tarot/symbol#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix vann:  <http://purl.org/vocab/vann/> .

# 
# An optional vocabulary of symbology, mainly based around those symbols present in the
# Rider-Waite-Smith tarot deck.
#
# This file is published separately to the cards - this is by design and the main intention
# is that this demonstrates the extension points in the main ontology that can be used for 
# adding symbology (tarot:Symbol and, in the example decks, tarot:depictsSymbol).
# 
# This vocab uses SKOS to represent the hierarchy of things a card can depict, marrying each
# term to narrower/broader terms or to other adjacent (related) terms.
#
<https://w3id.org/tarot/symbol> a skos:ConceptScheme ;
    skos:prefLabel "Symbols"@en ;
    skos:definition "Things a tarot card can depict, and the ways it depicts them."@en ;
    dcterms:title "Tarot Symbols"@en ;
    dcterms:description "A shared, non-exhaustive vocabulary of things tarot cards depict, built mainly from the Rider-Waite-Smith and Marseille decks. Optional: decks may use concepts from any scheme, or link their own concepts into this one with skos:broader or skos:exactMatch."@en ;
    dcterms:creator <https://github.com/mikeyhogarth> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-30"^^xsd:date ;
    dcterms:requires <https://w3id.org/tarot/ontology> ;
    vann:preferredNamespacePrefix "symbol" ;
    vann:preferredNamespaceUri "https://w3id.org/tarot/symbol#" .

#################################################################
# Animals
#################################################################

symbol:Animal a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Animal"@en ;
    skos:definition "A living creature other than a human or plant, drawn in any form."@en .

symbol:Bird a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Bird"@en ;
    skos:definition "A feathered, winged animal, often shown in flight or perched."@en .

symbol:Dove a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Bird ;
    skos:prefLabel "Dove"@en ;
    skos:definition "A small, plump, usually white bird with a gentle appearance."@en .

symbol:Eagle a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Bird ;
    skos:related symbol:Tetramorph ;
    skos:prefLabel "Eagle"@en ;
    skos:definition "A large bird of prey with broad wings, a hooked beak and sharp talons."@en .

symbol:Falcon a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Bird ;
    skos:prefLabel "Falcon"@en ;
    skos:definition "A swift bird of prey with pointed wings and a hooked beak."@en .

symbol:Ibis a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Bird ;
    skos:prefLabel "Ibis"@en ;
    skos:definition "A long-legged wading bird with a long, downward-curving bill."@en .

symbol:Butterfly a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Butterfly"@en ;
    skos:definition "A winged insect with large, often brightly coloured wings."@en .

symbol:Crayfish a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Crayfish"@en ;
    skos:definition "A freshwater crustacean with a hard shell, claws and a segmented tail."@en .

symbol:Fish a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Fish"@en ;
    skos:definition "A cold-blooded water animal with fins, scales and a tail."@en .

symbol:Mammal a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Mammal"@en ;
    skos:definition "A warm-blooded, furred animal that bears live young."@en .

symbol:Bull a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:related symbol:Tetramorph ;
    skos:prefLabel "Bull"@en ;
    skos:definition "An adult male bovine with horns and a heavy, muscular build."@en .

symbol:Cat a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:prefLabel "Cat"@en ;
    skos:definition "A small, furred domestic animal with pointed ears and a long tail."@en .

symbol:Dog a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:related symbol:Wolf ;
    skos:prefLabel "Dog"@en ;
    skos:definition "A domesticated canine, often shown with its tongue out or at its master's side."@en .

symbol:Horse a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:prefLabel "Horse"@en ;
    skos:definition "A large, hoofed animal with a mane and tail, often ridden or harnessed."@en .

symbol:Lion a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:related symbol:Tetramorph ;
    skos:prefLabel "Lion"@en ;
    skos:definition "A large tawny cat, the male with a thick mane."@en .

symbol:Rabbit a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:prefLabel "Rabbit"@en ;
    skos:definition "A small, long-eared mammal with a short tail."@en .

symbol:Ram a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:prefLabel "Ram"@en ;
    skos:definition "An adult male sheep with curled horns."@en .

symbol:Wolf a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mammal ;
    skos:prefLabel "Wolf"@en ;
    skos:definition "A wild canine with a lean body, pointed ears and a bushy tail."@en .

symbol:Salamander a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Salamander"@en ;
    skos:definition "A slender, lizard-like amphibian with a long tail."@en .

symbol:Shell a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Shell"@en ;
    skos:definition "A sea creature's hard shell, such as a scallop or conch."@en .

symbol:Snail a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Snail"@en ;
    skos:definition "A soft-bodied mollusc carrying a spiral shell on its back."@en .

symbol:Snake a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Animal ;
    skos:prefLabel "Snake"@en ;
    skos:definition "A long, limbless reptile with scaly skin, often shown coiled."@en .

#################################################################
# Celestial
#################################################################

symbol:Celestial a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Celestial"@en ;
    skos:definition "A body or light seen in the sky beyond the earth."@en .

symbol:Eclipse a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Celestial ;
    skos:related symbol:Moon, symbol:Sun ;
    skos:prefLabel "Eclipse"@en ;
    skos:definition "A dark disc passing across or blocking a luminous one, drawn as a darkened moon or sun, often ringed with light."@en .

symbol:Moon a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Celestial ;
    skos:related symbol:Sun ;
    skos:prefLabel "Moon"@en ;
    skos:definition "The earth's natural satellite, shown as a disc or crescent."@en .

symbol:Star a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Celestial ;
    skos:prefLabel "Star"@en ;
    skos:definition "A point of light in the sky, usually drawn with radiating points."@en .

symbol:Sun a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Celestial ;
    skos:prefLabel "Sun"@en ;
    skos:definition "The star at the centre of our solar system, drawn as a bright disc, often with rays."@en .

#################################################################
# Clothing
#################################################################

symbol:Clothing a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Clothing"@en ;
    skos:definition "Garments and accessories worn on the body."@en .

symbol:Armour a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:related symbol:Shield ;
    skos:prefLabel "Armour"@en ;
    skos:definition "Protective metal covering worn on the body in combat."@en .

symbol:Bandage a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:prefLabel "Bandage"@en ;
    skos:definition "A strip of cloth wrapped around part of the body, usually over a wound."@en .

symbol:Blindfold a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:related symbol:ObscuredFace ;
    skos:prefLabel "Blindfold"@en ;
    skos:definition "A cloth tied over the eyes to prevent sight."@en .

symbol:Cloak a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:prefLabel "Cloak"@en ;
    skos:definition "A loose, sleeveless outer garment hanging from the shoulders."@en .

symbol:Feather a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:prefLabel "Feather"@en ;
    skos:definition "A single light plume from a bird, often worn as decoration."@en .

symbol:Glove a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:prefLabel "Glove"@en ;
    skos:definition "A covering for the hand with separate sheaths for the fingers."@en .

symbol:Headwear a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:prefLabel "Headwear"@en ;
    skos:definition "Anything worn on the head."@en .

symbol:Crown a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Headwear ;
    skos:related symbol:King, symbol:Queen ;
    skos:prefLabel "Crown"@en ;
    skos:definition "A circular ornamental headdress worn by a ruler."@en .

symbol:Hat a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Headwear ;
    skos:prefLabel "Hat"@en ;
    skos:definition "A head covering with a brim, often broad and sometimes plumed."@en .

symbol:Wreath a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Headwear ;
    skos:prefLabel "Wreath"@en ;
    skos:definition "A ring of leaves, flowers or branches worn on the head or hung up."@en .

symbol:Nudity a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Clothing ;
    skos:prefLabel "Nudity"@en ;
    skos:definition "A human figure shown without clothing."@en .

#################################################################
# Compositions
#################################################################

symbol:Composition a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Composition"@en ;
    skos:definition "A way the elements of a card are arranged in relation to one another."@en .

symbol:Conflict a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Composition ;
    skos:prefLabel "Conflict"@en ;
    skos:definition "Figures set against one another, fighting or armed to fight."@en .

symbol:FlankingPair a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Composition ;
    skos:prefLabel "Flanking pair"@en ;
    skos:definition "Two figures standing on opposite sides of a central figure or object."@en .

symbol:NoSentientFigures a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Composition ;
    skos:prefLabel "No sentient figures"@en ;
    skos:definition "A scene with no figure, animal or other living being in it, only objects, landscape or weather."@en .

symbol:PresidingFigure a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Composition ;
    skos:prefLabel "Presiding figure"@en ;
    skos:definition "A central figure or object raised above other figures."@en .

symbol:StageBackdrop a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Composition ;
    skos:prefLabel "Stage backdrop"@en ;
    skos:definition "Figures set in a shallow foreground, as if on a stage, against a background that looks like painted scenery."@en .

symbol:TwinPillars a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Composition ;
    skos:prefLabel "Twin pillars"@en ;
    skos:definition "A central figure set between two matching pillars."@en .

#################################################################
# Figures
#################################################################

symbol:Figure a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Figure"@en ;
    skos:definition "A person or human-like form."@en .

symbol:Bishop a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Figure ;
    skos:prefLabel "Bishop"@en ;
    skos:definition "A senior Christian cleric, usually shown in ceremonial robes and a mitre."@en .

symbol:Child a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Figure ;
    skos:prefLabel "Child"@en ;
    skos:definition "A young human, shown as a small boy or girl."@en .

symbol:King a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Figure ;
    skos:related symbol:Knight, symbol:Page, symbol:Queen ;
    skos:prefLabel "King"@en ;
    skos:definition "A male monarch, usually shown crowned and enthroned."@en .

symbol:Knight a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Figure ;
    skos:related symbol:Page, symbol:Queen ;
    skos:prefLabel "Knight"@en ;
    skos:definition "A mounted warrior, usually shown in armour."@en .

symbol:Page a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Figure ;
    skos:related symbol:Queen ;
    skos:prefLabel "Page"@en ;
    skos:definition "A young attendant or messenger, shown standing."@en .

symbol:Queen a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Figure ;
    skos:prefLabel "Queen"@en ;
    skos:definition "A female monarch, usually shown crowned and enthroned."@en .

symbol:Skeleton a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Figure ;
    skos:prefLabel "Skeleton"@en ;
    skos:definition "The bony framework of a body, shown without flesh."@en .

#################################################################
# Landscape
#################################################################

symbol:Landscape a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Landscape"@en ;
    skos:definition "A stretch of natural scenery."@en .

symbol:Cliff a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Landscape ;
    skos:prefLabel "Cliff"@en ;
    skos:definition "A steep rock face, usually at the edge of the sea or a drop."@en .

symbol:Desert a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Landscape ;
    skos:prefLabel "Desert"@en ;
    skos:definition "A dry, sandy region with little vegetation."@en .

symbol:Field a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Landscape ;
    skos:prefLabel "Field"@en ;
    skos:definition "An open area of land, often cultivated."@en .

symbol:Hill a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Landscape ;
    skos:related symbol:Mountain ;
    skos:prefLabel "Hill"@en ;
    skos:definition "A rounded rise in the land, lower than a mountain."@en .

symbol:Mountain a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Landscape ;
    skos:prefLabel "Mountain"@en ;
    skos:definition "A large, steep and high natural elevation of the land."@en .

symbol:Path a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Landscape ;
    skos:prefLabel "Path"@en ;
    skos:definition "A narrow track or way along the ground."@en .

symbol:Rock a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Landscape ;
    skos:prefLabel "Rock"@en ;
    skos:definition "A large mass of stone standing on the ground."@en .

#################################################################
# Mythical
#################################################################

symbol:Mythical a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Mythical"@en ;
    skos:definition "A being or attribute from myth, legend or religion rather than the natural world."@en .

symbol:Angel a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:related symbol:Tetramorph ;
    skos:prefLabel "Angel"@en ;
    skos:definition "A winged, usually robed spiritual being."@en .

symbol:Cherub a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Angel ;
    skos:related symbol:Child ;
    skos:prefLabel "Cherub"@en ;
    skos:definition "A small, winged angel in the form of a child."@en .

symbol:Devil a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:prefLabel "Devil"@en ;
    skos:definition "A horned, bat-winged demonic figure."@en .

symbol:Dragon a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:prefLabel "Dragon"@en ;
    skos:definition "A large, winged, scaly, serpent-like creature."@en .

symbol:Halo a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:prefLabel "Halo"@en ;
    skos:definition "A ring or disc of light drawn around a head."@en .

symbol:Hand a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:prefLabel "Hand"@en ;
    skos:definition "A hand emerging from a cloud, holding out an object."@en .

symbol:Hermanubis a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:prefLabel "Hermanubis"@en ;
    skos:definition "A figure combining the Greek god Hermes with the jackal-headed Egyptian god Anubis."@en .

symbol:Sphinx a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:prefLabel "Sphinx"@en ;
    skos:definition "A creature with a lion's body and a human head."@en .

symbol:Tetramorph a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Mythical ;
    skos:prefLabel "Tetramorph"@en ;
    skos:definition "The four winged living creatures of religious vision - a man or angel, a lion, a bull and an eagle - drawn together, usually in the sky."@en .

#################################################################
# Objects
#################################################################

symbol:Object a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Object"@en ;
    skos:definition "A man-made, movable thing."@en .

symbol:Banner a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Object ;
    skos:prefLabel "Banner"@en ;
    skos:definition "A flag or strip of cloth hung from a pole."@en .

symbol:Book a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Object ;
    skos:prefLabel "Book"@en ;
    skos:definition "A set of bound pages, usually held open or shut."@en .

symbol:Chain a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Object ;
    skos:prefLabel "Chain"@en ;
    skos:definition "A series of connected metal links."@en .

symbol:Coin a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Object ;
    skos:related symbol:Pentacle ;
    skos:prefLabel "Coin"@en ;
    skos:definition "A flat, round disc of metal, drawn as money and decorated with a pattern rather than a star."@en .

symbol:Container a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Object ;
    skos:prefLabel "Container"@en ;
    skos:definition "An object for holding or carrying things."@en .

symbol:Coffin a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Container ;
    skos:related symbol:Tomb ;
    skos:prefLabel "Coffin"@en ;
