#################################################################
# Pose
#################################################################

symbol:Pose a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Pose"@en ;
    skos:definition "The way a human figure is turned or looking, relative to the viewer."@en .

symbol:DownwardGaze a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:related symbol:UpwardGaze ;
    skos:prefLabel "Downward gaze"@en ;
    skos:definition "A human figure whose eyes or head are lowered, looking down."@en .

symbol:FacingAway a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:related symbol:FrontalPose ;
    skos:prefLabel "Facing away"@en ;
    skos:definition "A human figure with their back turned to the viewer."@en .

symbol:FrontalPose a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:prefLabel "Frontal pose"@en ;
    skos:definition "A human figure facing the viewer, with body and face turned towards them."@en .

symbol:LeftProfile a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:related symbol:RightProfile ;
    skos:prefLabel "Left profile"@en ;
    skos:definition "A human figure turned side-on, facing the viewer's left."@en .

symbol:ObscuredFace a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:prefLabel "Obscured face"@en ;
    skos:definition "A human figure whose face is hidden by hands, cloth or an object."@en .

symbol:Restraint a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:prefLabel "Restraint"@en ;
    skos:definition "A human figure bound, tied or held in place so that they cannot move freely."@en .

symbol:RightProfile a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:prefLabel "Right profile"@en ;
    skos:definition "A human figure turned side-on, facing the viewer's right."@en .

symbol:UpwardGaze a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Pose ;
    skos:prefLabel "Upward gaze"@en ;
    skos:definition "A human figure whose eyes or head are raised, looking up."@en .

#################################################################
# Signs
#################################################################

symbol:Sign a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:topConceptOf <https://w3id.org/tarot/symbol> ;
    skos:prefLabel "Sign"@en ;
    skos:definition "A mark, shape or glyph used to stand for something."@en .

symbol:Ankh a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Sign ;
    skos:prefLabel "Ankh"@en ;
    skos:definition "An Egyptian cross with a loop at the top."@en .

symbol:Cross a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Sign ;
    skos:prefLabel "Cross"@en ;
    skos:definition "A shape made of an upright and a transverse bar."@en .

symbol:Heart a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Sign ;
    skos:prefLabel "Heart"@en ;
    skos:definition "A traditional heart symbol, such as found on playing cards."@en .

symbol:Infinity a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Sign ;
    skos:prefLabel "Infinity"@en ;
