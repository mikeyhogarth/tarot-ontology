symbol:Knapsack a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Container ;
    skos:prefLabel "Knapsack"@en ;
    skos:definition "A bag carried on the back or slung from a stick."@en .

symbol:Vessel a tarot:Symbol, skos:Concept ;
    skos:inScheme <https://w3id.org/tarot/symbol> ;
    skos:broader symbol:Container ;
